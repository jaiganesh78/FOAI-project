# ==============================================================================
# AI-Powered Government Policy Intelligence Platform (GPIOS)
# Environment Configuration Template
# Do NOT place sensitive secrets or production credentials in this file.
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3001
APP_NAME=GPIOS-Backend
APP_VERSION=1.0.0
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://gpios_user:gpios_password@localhost:5432/gpios_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3 Storage Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_aws_access_key_id
AWS_SECRET_ACCESS_KEY=placeholder_aws_secret_access_key
AWS_S3_BUCKET=gpios-policy-documents

# AI Services Configuration
GEMINI_API_KEY=placeholder_gemini_api_key
LANGFUSE_PUBLIC_KEY=placeholder_langfuse_public_key
LANGFUSE_SECRET_KEY=placeholder_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Monitoring & Telemetry
SENTRY_DSN=https://placeholder@sentry.io/123456
LOG_LEVEL=debug

# Email & Notifications Configuration
RESEND_API_KEY=re_placeholder_api_key

# Security & Secrets Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production
ENCRYPTION_KEY=32_character_key_for_aes_256_enc
