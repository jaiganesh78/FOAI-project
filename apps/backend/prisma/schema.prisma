  clearedAt                   DateTime?
  version                     Int       @default(1)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@unique([userId, targetType, targetEntityId])
  @@map("stale_states")
}

model PolicyVersionActivation {
  id                           String   @id @default(uuid())
  policyId                     String
  policyTitle                  String
  version                      Int
  activationReason             String
  checksumSha256               String
  affectedFacts                Json
  affectedRules                Json
  affectedAttributeKeys        Json
  discoveredPopulationCount    Int      @default(0)
  populationSelectionChecksum  String
  activatedBy                  String
  activatedAt                  DateTime @default(now())
  createdAt                    DateTime @default(now())

  @@unique([policyId, version])
  @@map("policy_version_activations")
}

// ==========================================
// Sprint 12 — Enterprise Citizen Communication & Action Center Models
// ==========================================

model Notification {
  id                            String    @id @default(uuid())
  userId                        String
  notificationType              String
  title                         String
  body                          String
  priority                      String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status                        String    @default("CREATED") // CREATED | RENDERED | QUEUED | PARTIALLY_DELIVERED | DELIVERED | READ | FAILED | SUPPRESSED | SUPERSEDED | EXPIRED
  actionItemId                  String?
  sourceReEvaluationId          String
  sourceDecisionDiffId          String
  sourceEventId                 String
  templateId                    String
  templateVersion               Int
  policyId                      String
  policyVersion                 Int
  policyChecksumSha256          String
  dependencyFingerprintSha256   String
  checksumSha256                String
  supersededByNotificationId   String?
  idempotencyKey                String
  // DEF-003 FIX: Persists original template parameters to support deterministic replay
  templateParameters            Json?
  readAt                        DateTime?
  version                       Int       @default(1)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  deliveries                    NotificationDelivery[]
  attempts                      NotificationDeliveryAttempt[]

  @@unique([userId, idempotencyKey])
  @@unique([sourceEventId, notificationType, userId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([sourceDecisionDiffId])
  @@index([sourceReEvaluationId])
  @@map("notifications")
}

model NotificationDelivery {
  id                      String    @id @default(uuid())
  notificationId          String
  userId                  String
  channel                 String    // IN_APP | EMAIL | SMS | PUSH
  status                  String    @default("PENDING") // PENDING | LEASED | PROCESSING | SUCCEEDED | RETRY_SCHEDULED | PERMANENT_FAILURE | CANCELLED
  providerName            String?
  deliveryIdempotencyKey  String
  scheduledAt             DateTime  @default(now())
  deliveredAt             DateTime?
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  retryCount              Int       @default(0)
  maxRetries              Int       @default(5)
  // DEF-006 FIX: Persists next eligible retry time for exponential backoff scheduling
  nextRetryAt             DateTime?  // null = no retry scheduled; future = do not process before this time
  failureReason           String?
  failureCategory         String?   // TRANSIENT | PERMANENT | RATE_LIMITED | INVALID_DESTINATION | PROVIDER_UNAVAILABLE | AUTHENTICATION_FAILURE | POLICY_REJECTED
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  notification            Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attempts                NotificationDeliveryAttempt[]

  @@unique([notificationId, channel])
  @@unique([deliveryIdempotencyKey])
  // Updated index includes nextRetryAt for efficient worker polling of eligible retries
  @@index([status, scheduledAt, leaseExpiresAt, nextRetryAt])
  @@index([userId, channel])
  @@map("notification_deliveries")
}

model NotificationDeliveryAttempt {
  id                      String    @id @default(uuid())
  deliveryId              String
  notificationId          String
  channel                 String
  providerName            String
  status                  String    // PENDING | PROCESSING | SUCCEEDED | FAILED | RETRY_SCHEDULED | DEAD_LETTERED | CANCELLED
  attemptNumber           Int
  errorMessage            String?
  errorCode               String?
  failureCategory         String?
  durationMs              Int
  providerMessageId       String?
  requestPayloadSanitized  Json?
  responsePayloadSanitized Json?
  createdAt               DateTime  @default(now())

  delivery                NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  notification            Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([notificationId, channel])
  @@map("notification_delivery_attempts")
}

model CitizenActionItem {
  id                      String    @id @default(uuid())
  userId                  String
  actionType              String    // REVIEW_ELIGIBILITY | REVIEW_RECOMMENDATION | UPLOAD_EVIDENCE | COMPLETE_ONBOARDING | COMPLETE_PREREQUISITE | ACKNOWLEDGE_POLICY_CHANGE
  title                   String
  description             String
  status                  String    @default("PENDING") // PENDING | VIEWED | ACKNOWLEDGED | ACTION_REQUIRED | COMPLETED | DISMISSAL_REQUESTED | DISMISSED | EXPIRED | SUPERSEDED
  priority                String    @default("MEDIUM")
  targetUrl               String
  deadline                DateTime?
  sourceEntityId          String
  idempotencyKey          String
  version                 Int       @default(1)
  completedAt             DateTime?
  dismissedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([userId, deadline])
  @@index([sourceEntityId])
  @@map("citizen_action_items")
}

model NotificationTemplateVersion {
  id                      String    @id @default(uuid())
  templateId              String
  version                 Int
  locale                  String    @default("en-IN")
  titleTemplate           String
  bodyTemplate            String
  actionUrlTemplate       String?
  checksumSha256          String
  createdBy               String
  createdAt               DateTime  @default(now())

  @@unique([templateId, version, locale])
  @@map("notification_template_versions")
}

model NotificationPolicyVersion {
  id                      String    @id @default(uuid())
  policyId                String
  version                 Int
  minMaterialityLevel     String    @default("MEDIUM")
  cooldownWindowSeconds   Int       @default(300)
  maxPerWindow            Int       @default(3)
  allowedChannels         Json
  fallbackPrecedence      Json
  checksumSha256          String
  activatedBy             String
  activatedAt             DateTime  @default(now())
  createdAt               DateTime  @default(now())

  @@unique([policyId, version])
  @@map("notification_policy_versions")
}

model NotificationPreference {
  id                      String    @id @default(uuid())
  userId                  String
  channel                 String    // IN_APP | EMAIL | SMS | PUSH
  status                  String    @default("ENABLED") // ENABLED | DISABLED | NOT_CONFIGURED
  quietHoursStart         String?   // HH:mm (e.g. "22:00")
  quietHoursEnd           String?   // HH:mm (e.g. "07:00")
  timezone                String    @default("Asia/Kolkata")
  categoryOverrides       Json?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model NotificationSuppression {
  id                      String    @id @default(uuid())
  userId                  String
  sourceEventId           String
  sourceDecisionDiffId    String
  notificationType        String
  suppressionReason       String    // COOLDOWN_ACTIVE | RATE_LIMIT_EXCEEDED | QUIET_HOURS_ACTIVE | CHANNEL_DISABLED | IMMATERIAL_CHANGE | SUPERSEDED
  policyId                String
  policyVersion           Int
  policyChecksumSha256    String
  originalEvaluationTime  DateTime  @default(now())
  nextEligibleDeliveryTime DateTime?
  createdAt               DateTime  @default(now())

  @@index([userId, notificationType])
  @@index([sourceDecisionDiffId])
  @@map("notification_suppressions")
}

model NotificationOutbox {
  id                      String    @id @default(uuid())
  eventId                 String
  eventType               String
  payload                 Json
  status                  String    @default("PENDING") // PENDING | LEASED | PROCESSED | FAILED
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  retryCount              Int       @default(0)
  scheduledAt             DateTime  @default(now())
  processedAt             DateTime?
  errorMessage            String?
  createdAt               DateTime  @default(now())

  @@index([status, scheduledAt, leaseExpiresAt])
  @@map("notification_outbox")
}






