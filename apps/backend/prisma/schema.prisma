  @@index([actionPlanId])
  @@map("action_plan_steps")
}

model JourneySnapshot {
  id                       String   @id @default(uuid())
  journeyId                String
  userId                   String
  citizenSnapshotId        String
  eligibilitySnapshotId    String
  recommendationSnapshotId String
