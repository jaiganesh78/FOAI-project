enum ApplicationJourneyStatus {
  CREATED
  PLANNED
  READY
  IN_PROGRESS
  WAITING_FOR_DOCUMENTS
  WAITING_FOR_VERIFICATION
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  BENEFIT_RECEIVED
  CLOSED
  ARCHIVED
}

enum JourneyStepStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  READY
  COMPLETED
  SKIPPED
}

enum ChecklistStatus {
  PENDING
  PARTIALLY_MET
  COMPLETED
  EXPIRED
}

enum DocumentRequirementStatus {
  REQUIRED
  PROVIDED
  VERIFIED
  REJECTED
  EXPIRED
}

enum JourneyUrgency {
  LOW
  MEDIUM
  HIGH
