model JourneyAnalytics {
  id                                 Int      @id @default(autoincrement())
  userId                             String
  averageJourneyDurationMs           Int      @default(0)
  averageApprovalDurationMs          Int      @default(0)
  averageStepDurationMs              Int      @default(0)
  averageWaitingTimeMs               Int      @default(0)
  averageVerificationTimeMs          Int      @default(0)
  longestBlockingStepTitle           String   @default("")
  deadlineMissRate                   Float    @default(0.0)
  journeyReplayDurationMs            Int      @default(0)
  snapshotCreationDurationMs         Int      @default(0)
