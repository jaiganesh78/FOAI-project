  itemKey     String
  title       String
  type        String               @default("FACT")
  status      ChecklistStatus      @default(PENDING)
  isMandatory Boolean              @default(true)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  checklist   ApplicationChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("checklist_items")
}

model DocumentRequirement {
