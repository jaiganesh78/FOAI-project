generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum UserStatus {
  ACTIVE
  LOCKED
  SUSPENDED
}

enum AuthProviderType {
  LOCAL
  GOOGLE
  MICROSOFT
  AADHAAR
  WEBAUTHN
}

enum ProfileStatus {
  CREATED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  VERIFIED
  ARCHIVED
}

enum FactCategory {
  PERSONAL
  DEMOGRAPHICS
  FAMILY
  EDUCATION
  OCCUPATION
  FINANCIAL
  ADDRESS
  AGRICULTURE
  DISABILITY
  COMMUNITY
  RELIGION
  GOVERNMENT_IDENTIFIER
  CUSTOM
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  ENUM
  JSON
}

enum VerificationStatus {
  UNVERIFIED
  SELF_DECLARED
  SYSTEM_VERIFIED
  DOCUMENT_VERIFIED
  REJECTED
}

enum CreationMethod {
  USER_FORM
  OCR
  ADMIN
  DIGILOCKER
  API
  IMPORT
  AI_EXTRACTION
}

enum ConfidenceSource {
  USER
  DOCUMENT
  AI
  ADMIN
  SYSTEM
}

enum OnboardingSessionStatus {
  STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum QuestionInputType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  RADIO
  CHECKBOX
  MULTI_SELECT
  TEXTAREA
}

enum AnswerStatus {
  DRAFT
  SUBMITTED
  VALIDATED
}

enum PolicyLifecycleStatus {
  DISCOVERED
  DOWNLOADED
  PROCESSED
  NORMALIZED
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum KnowledgeSourceType {
  PORTAL
  GAZETTE
  API
  BUDGET
  SCHOLARSHIP
  GAZETTE_PDF
}

enum CrawlStrategy {
  REALTIME_POLL
  CRON_SCHEDULE
  WEB_SCRAPE
  MANUAL_UPLOAD
  API_PULL
}

enum PolicyRelationshipType {
  SUPERSEDES
  DEPENDS_ON
  EXTENDS
  RELATED_SCHEME
  REQUIRED_DOCUMENT
  PARENT_POLICY
  CHILD_POLICY
}

enum DocumentClassification {
  SCHEME
  GOVERNMENT_ORDER
  GAZETTE
  CIRCULAR
  NOTIFICATION
  AMENDMENT
  GUIDELINE
  FAQ
  BUDGET
  PRESS_RELEASE
}

enum EmbeddingStatus {
  PENDING
  GENERATED
  FAILED
}

enum EligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  POTENTIALLY_ELIGIBLE
  REQUIRES_MORE_DATA
  EXPIRED
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  LESS_THAN
  GREATER_OR_EQUAL
  LESS_OR_EQUAL
  BETWEEN
  IN
  NOT_IN
  EXISTS
  NOT_EXISTS
  REGEX
  BOOLEAN
}

enum LogicalGroupOperator {
  ALL
  ANY
  NONE
  X_OF_Y
}

enum RuleEvaluationCost {
  LOW
  MEDIUM
  HIGH
}

enum RuleDependencyType {
  DEPENDS_ON
  BLOCKS
  REQUIRES
  OPTIONAL
}

enum OpportunityGapType {
  INCOME_THRESHOLD_EXCEEDED
  AGE_THRESHOLD_NOT_MET
  MISSING_IDENTIFIER
  MISSING_EVIDENCE
  LOCATION_MISMATCH
}

enum RecommendationStatus {
  ACTIVE
  SUPERSEDED
  EXPIRED
  ARCHIVED
}

enum RecommendationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RecommendationLifecycleStatus {
  GENERATED
  RECOMMENDED
  VIEWED
  SAVED
  IN_PROGRESS
  APPLIED
  APPROVED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum ApplicationReadinessStatus {
  READY
  PARTIALLY_READY
  MISSING_DOCUMENTS
  NOT_READY
}

enum RecommendationChangeType {
  ADDED
  REMOVED
  MOVED
  UPDATED
  EXPIRED
}

enum RecommendationFeedbackAction {
  VIEWED
  IGNORED
  SAVED
  DISMISSED
  APPLIED
  COMPLETED
  EXPIRED
  HIDDEN
}

model SystemHealthCheck {
  id        String   @id @default(uuid())
  status    String
  createdAt DateTime @default(now())

  @@map("system_health_checks")
}

model User {
  id                     String           @id @default(uuid())
  email                  String           @unique
  fullName               String
  status                 UserStatus       @default(ACTIVE)
  isEmailVerified        Boolean          @default(false)
  lastLoginAt            DateTime?
  failedLoginCount       Int              @default(0)
  accountLockedUntil     DateTime?
  passwordChangedAt      DateTime?
  version                Int              @default(1)
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  identities             AuthIdentity[]
  userRoles              UserRole[]
  refreshSessions        RefreshSession[]
  loginHistories         LoginHistory[]
  citizenProfile         CitizenProfile?
  onboardingSession      OnboardingSession?
  applicationJourneys    ApplicationJourney[]
  documents              Document[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id             String           @id @default(uuid())
  userId         String
  provider       AuthProviderType @default(LOCAL)
  providerUserId String
  passwordHash   String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  version         Int              @default(1)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  action          String           @unique
  description     String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshSession {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  isRevoked           Boolean   @default(false)
  expiresAt           DateTime
  ipAddress           String?
  userAgent           String?
  deviceName          String?
  platform            String?
  browser             String?
  operatingSystem     String?
  approximateLocation String?
  lastActivityAt      DateTime  @default(now())
  replacedByTokenId   String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

model LoginHistory {
  id            String   @id @default(uuid())
  userId        String?
  email         String
  status        String
  ipAddress     String?
  userAgent     String?
  requestId     String?
  failureReason String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email])
  @@map("login_histories")
}

model CitizenProfile {
  id                    String            @id @default(uuid())
  userId                String            @unique
  status                ProfileStatus     @default(CREATED)
  completionPercentage  Float             @default(0.0)
  version               Int               @default(1)
  deletedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts                 CitizenFact[]
  versions              CitizenProfileVersion[]
  profileSnapshots      ProfileSnapshot[]

  @@index([userId])
  @@index([status])
  @@map("citizen_profiles")
}

model CitizenAttributeRegistry {
  id                    String            @id @default(uuid())
  key                   String            @unique
  displayName           String
  category              FactCategory
  dataType              AttributeDataType
  isMandatory           Boolean           @default(false)
  isSearchable          Boolean           @default(true)
  isFilterable          Boolean           @default(true)
  isAiSearchable        Boolean           @default(true)
  isCopilotVisible      Boolean           @default(true)
  isEligibilityRelevant Boolean           @default(true)
  isSensitiveData       Boolean           @default(false)
  piiClassification     String            @default("LOW")
  displayOrder          Int               @default(0)
  uiGroup               String            @default("GENERAL")
  parentKey             String?
  activationCondition   String?
  dependencyRules       Json?
  validationRules       Json?
  description           String?
  version               Int               @default(1)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  facts                 CitizenFact[]
  questions             QuestionCatalog[]

  @@index([key])
  @@index([category, isActive])
  @@map("citizen_attribute_registry")
}

model CitizenFact {
  id                    String            @id @default(uuid())
  profileId             String
  attributeKey          String
  valueText             String?
  valueNumber           Float?
  valueBoolean          Boolean?
  valueDate             DateTime?
  valueJson             Json?
  normalizedValue       Json?
  confidence            Float             @default(1.0)
  confidenceSource      ConfidenceSource  @default(USER)
  confidenceStrategy    String            @default("DETERMINISTIC")
  verificationLevel     String            @default("SELF_DECLARED")
  verificationStatus    VerificationStatus @default(SELF_DECLARED)
  source                String            @default("MANUAL")
  sourcePrecedence      Int               @default(5)
  freshnessStatus       String            @default("FRESH")
  freshnessExpiryDate   DateTime?
  freshnessPolicyVersion Int              @default(1)
  creationMethod        CreationMethod    @default(USER_FORM)
  createdBy             String
  evidenceId            String?
  isCurrent             Boolean           @default(true)
  version               Int               @default(1)
  effectiveFrom         DateTime          @default(now())
  effectiveTo           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  profile               CitizenProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  attribute             CitizenAttributeRegistry  @relation(fields: [attributeKey], references: [key])
  evidence              FactEvidence?             @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  history               CitizenFactHistory[]
  factVersions          CitizenFactVersion[]
  provenances           FactProvenance[]

  @@unique([profileId, attributeKey])
  @@index([profileId, isCurrent])
  @@index([attributeKey])
  @@index([verificationStatus])
  @@map("citizen_facts")
}

model CitizenFactHistory {
  id            String            @id @default(uuid())
  factId        String
  version       Int
  previousValue Json?
  newValue      Json?
  effectiveDate DateTime          @default(now())
  changeReason  String?
  changedBy     String
  createdAt     DateTime          @default(now())

  fact          CitizenFact       @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@index([factId])
  @@map("citizen_fact_history")
}

model CitizenProfileVersion {
  id            String            @id @default(uuid())
  profileId     String
  versionNumber Int
  snapshot      Json
  changeSummary String?
  createdAt     DateTime          @default(now())

  profile       CitizenProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, versionNumber])
  @@map("citizen_profile_versions")
}

model FactEvidence {
  id                 String             @id @default(uuid())
  documentType       String
  issuingAuthority   String?
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  storageRef         String?
  checksum           String?
  metadata           Json?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  facts              CitizenFact[]

  @@map("fact_evidence")
}

model DiscoveryBlueprint {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  targetPersona       String               @default("ALL")
  categories          Json
  stepOrdering        Json
  completionRules     Json?
  version             Int                  @default(1)
  publishedAt         DateTime             @default(now())
  retiredAt           DateTime?
  previousBlueprintId String?
  nextBlueprintId     String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  sessions            OnboardingSession[]

  @@map("discovery_blueprints")
}

model QuestionCatalog {
  id                String               @id @default(uuid())
  attributeKey      String
  questionCode      String               @unique
  label             String
  description       String?
  helpText          String?
  placeholder       String?
  inputType         QuestionInputType    @default(TEXT)
  options           Json?
  renderingMetadata Json?
  displayGroup      String               @default("GENERAL")
  displayOrder      Int                  @default(0)
  variant           String               @default("DEFAULT")
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  attribute         CitizenAttributeRegistry @relation(fields: [attributeKey], references: [key])

  @@index([attributeKey])
  @@map("question_catalog")
}

model OnboardingSession {
  id                   String                  @id @default(uuid())
  userId               String                  @unique
  blueprintId          String
  blueprintVersion     Int                     @default(1)
  currentStep          String
  completedSteps       Json
  skippedSteps         Json
  draftAnswers         Json?
  completionPercentage Float                   @default(0.0)
  status               OnboardingSessionStatus @default(STARTED)
  version              Int                     @default(1)
  updatedBy            String
  previousState        Json?
  changeReason         String?
  lastActivityAt       DateTime                @default(now())
  completedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  blueprint            DiscoveryBlueprint      @relation(fields: [blueprintId], references: [id])
  timeline             OnboardingSessionTimeline[]

  @@index([userId])
  @@index([status])
  @@map("onboarding_sessions")
}

model OnboardingSessionTimeline {
  id          String            @id @default(uuid())
  sessionId   String
  eventType   String
  stepKey     String?
  questionKey String?
  details     Json?
  createdAt   DateTime          @default(now())

  session     OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("onboarding_session_timelines")
}

model OnboardingAnalytics {
  id                         String   @id @default(uuid())
  blueprintId                String
  stepKey                    String
  averageTimePerQuestionSec  Float    @default(0.0)
  firstPassCompletionRate    Float    @default(0.0)
  revisitCount               Int      @default(0)
  dependencyTriggerFrequency Int      @default(0)
  validationRetryRate        Float    @default(0.0)
  abandonedCount             Int      @default(0)
  skippedCount               Int      @default(0)
  updatedAt                  DateTime @updatedAt

  @@unique([blueprintId, stepKey])
  @@map("onboarding_analytics")
}

model KnowledgeSource {
  id                    String                   @id @default(uuid())
  code                  String                   @unique
  name                  String
  sourceType            KnowledgeSourceType      @default(PORTAL)
  baseUrl               String
  crawlStrategy         CrawlStrategy            @default(CRON_SCHEDULE)
  updateFrequencyCron   String                   @default("0 0 * * *")
  capabilities          Json
  healthStatus          String                   @default("HEALTHY")
  priority              Int                      @default(1)
  isActive              Boolean                  @default(true)
  deletedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  schedules             KnowledgeSourceSchedule[]
  documents             PolicyDocument[]
  jobs                  KnowledgeIngestionJob[]

  @@map("knowledge_sources")
}

model KnowledgeSourceSchedule {
  id                    String            @id @default(uuid())
  sourceId              String
  cronExpression        String
  adaptiveIntervalMin   Int               @default(60)
  lastRunAt             DateTime?
  nextRunAt             DateTime?
  retryCount            Int               @default(0)
  maxRetries            Int               @default(3)
  createdAt             DateTime          @default(now())

  source                KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("knowledge_source_schedules")
}

model PolicyDocument {
  id                    String                 @id @default(uuid())
  sourceId              String
  documentNumber        String                 @unique
  title                 String
  classification        DocumentClassification @default(SCHEME)
  status                PolicyLifecycleStatus  @default(DISCOVERED)
  currentVersionNumber  Int                    @default(1)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  source                KnowledgeSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  versions              PolicyVersion[]
  chunks                PolicyChunk[]
  fingerprints          KnowledgeFingerprint[]
  outgoingRelations     PolicyRelationship[]   @relation("SourceDocument")
  incomingRelations     PolicyRelationship[]   @relation("TargetDocument")
  qualityReports        KnowledgeQualityReport[]

  @@index([sourceId])
  @@index([status])
  @@map("policy_documents")
}

model PolicyVersion {
  id                    String                 @id @default(uuid())
  documentId            String
  versionNumber         Int
  fingerprintHash       String                 @unique
  rawContentUrl         String?
  effectiveDate         DateTime?
  expiryDate            DateTime?
  supersededByVersionId String?
  isCurrent             Boolean                @default(true)
  createdAt             DateTime               @default(now())

  document              PolicyDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks                PolicyChunk[]
  policyRules           PolicyRule[]

  @@unique([documentId, versionNumber])
  @@map("policy_versions")
}

model PolicyRelationship {
  id                    String                 @id @default(uuid())
  sourceDocumentId      String
  targetDocumentId      String
  relationshipType      PolicyRelationshipType

  sourceDocument        PolicyDocument         @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument        PolicyDocument         @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, targetDocumentId, relationshipType])
  @@map("policy_relationships")
}

model PolicyChunk {
  id                    String                 @id @default(uuid())
  documentId            String
  versionId             String
  stableChunkId         String
  chunkIndex            Int
  sectionTitle          String?
  pageNumber            Int?
  paragraphIndex        Int?
  content               String
  checksum              String
  createdAt             DateTime               @default(now())

  document              PolicyDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version               PolicyVersion          @relation(fields: [versionId], references: [id], onDelete: Cascade)
  metadata              PolicyChunkMetadata?
  embeddingPrep         EmbeddingPreparation?

  @@index([documentId, versionId])
  @@index([stableChunkId])
  @@map("policy_chunks")
}

model PolicyChunkMetadata {
  id                    String                 @id @default(uuid())
  chunkId               String                 @unique
  ministry              String?
  department            String?
  schemeName            String?
  state                 String?
  district              String?
  beneficiaryCategory   String?
  normalizedAmount      Float?
  extractionConfidence  Float                  @default(1.0)
  extractionMethod      String                 @default("DETERMINISTIC")
  extractedBy           String                 @default("SYSTEM")
  extractionTimestamp   DateTime               @default(now())
  sourceLocation        String?

  chunk                 PolicyChunk            @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("policy_chunk_metadata")
}

model KnowledgeFingerprint {
  id                    String                 @id @default(uuid())
  documentId            String
  fingerprintHash       String                 @unique
  documentSize          Int
  title                 String
  publicationDate       DateTime?
  sourceId              String
  createdAt             DateTime               @default(now())

  document              PolicyDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([fingerprintHash])
  @@map("knowledge_fingerprints")
}

model KnowledgeQualityReport {
  id                    String                 @id @default(uuid())
  documentId            String
  completenessScore     Float                  @default(1.0)
  parsingSuccess        Boolean                @default(true)
  metadataConfidence    Float                  @default(1.0)
  duplicateConfidence   Float                  @default(1.0)
  chunkCoverage         Float                  @default(1.0)
  normalizationSuccess  Boolean                @default(true)
  createdAt             DateTime               @default(now())

  document              PolicyDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_quality_reports")
}

model EmbeddingPreparation {
  id                    String                 @id @default(uuid())
  chunkId               String                 @unique
  status                EmbeddingStatus        @default(PENDING)
  embeddingVersion      String                 @default("v1")
  modelIdentifier       String                 @default("text-embedding-3-small")
  checksum              String
  updatedAt             DateTime               @updatedAt

  chunk                 PolicyChunk            @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("embedding_preparations")
}

model KnowledgeIngestionJob {
  id                         String            @id @default(uuid())
  sourceId                   String
  status                     String            @default("RUNNING")
  stage                      String            @default("DISCOVERY")
  processingDurationMs       Int               @default(0)
  parsingDurationMs          Int               @default(0)
  normalizationDurationMs    Int               @default(0)
  chunkGenerationDurationMs  Int               @default(0)
  storageDurationMs          Int               @default(0)
  errorMessage               String?
  createdAt                  DateTime          @default(now())
  completedAt                DateTime?

  source                     KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, status])
  @@map("knowledge_ingestion_jobs")
}

model PolicyRule {
  id               String              @id @default(uuid())
  policyVersionId  String
  ruleCode         String              @unique
  name             String
  description      String?
  estimatedCost    RuleEvaluationCost  @default(LOW)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  policyVersion    PolicyVersion       @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  versions         PolicyRuleVersion[]
  dependencies     RuleDependency[]    @relation("SourceRule")
  dependents       RuleDependency[]    @relation("TargetRule")

  @@map("policy_rules")
}

model PolicyRuleVersion {
  id               String              @id @default(uuid())
  ruleId           String
  versionNumber    Int
  logicFingerprint String
  isCurrent        Boolean             @default(true)
  createdAt        DateTime            @default(now())

  rule             PolicyRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groups           RuleGroup[]
  decisionTraces   DecisionTrace[]

  @@unique([ruleId, versionNumber])
  @@map("policy_rule_versions")
}

model RuleGroup {
  id                  String               @id @default(uuid())
  ruleVersionId       String
  parentGroupId       String?
  logicalOperator     LogicalGroupOperator @default(ALL)
  thresholdX          Int?

  ruleVersion         PolicyRuleVersion    @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  parentGroup         RuleGroup?           @relation("NestedGroups", fields: [parentGroupId], references: [id])
  childGroups         RuleGroup[]          @relation("NestedGroups")
  conditions          RuleCondition[]

  @@map("rule_groups")
}

model RuleCondition {
  id             String             @id @default(uuid())
  groupId        String
  attributeKey   String
  operator       RuleOperator
  expectedValue  Json
  description    String?
  estimatedCost  RuleEvaluationCost @default(LOW)

  group          RuleGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  factUsageIndex FactUsageIndex[]

  @@index([attributeKey])
  @@map("rule_conditions")
}

model ExplainabilityTemplate {
  id             String   @id @default(uuid())
  code           String   @unique
  templateText   String
  locale         String   @default("en-IN")
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("explainability_templates")
}

model RuleDependency {
  id             String             @id @default(uuid())
  sourceRuleId   String
  targetRuleId   String
  dependencyType RuleDependencyType @default(DEPENDS_ON)

  sourceRule     PolicyRule         @relation("SourceRule", fields: [sourceRuleId], references: [id], onDelete: Cascade)
  targetRule     PolicyRule         @relation("TargetRule", fields: [targetRuleId], references: [id], onDelete: Cascade)

  @@unique([sourceRuleId, targetRuleId, dependencyType])
  @@map("rule_dependencies")
}

model FactUsageIndex {
  id             String        @id @default(uuid())
  attributeKey   String
  conditionId    String
