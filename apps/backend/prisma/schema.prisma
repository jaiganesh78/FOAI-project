  VERIFICATION_COMPLETE
  APPLICATION_SUBMITTED
  STATUS_UPDATED
  APPROVED
  REJECTED
}

enum JourneyDependencyType {
  REQUIRES
  BLOCKS
  OPTIONAL
  PARALLEL
}

enum JourneyProgressType {
  OVERALL
  CATEGORY
  STEP
  DEPENDENCY
  DOCUMENT
  VERIFICATION
}

enum StepExecutionMode {
  MANUAL
  AUTOMATIC
}

enum StepOwner {
  CITIZEN
  GOVERNMENT_OFFICER
  EXTERNAL_AGENCY
}

enum StepBlockingBehavior {
  BLOCKING
  NON_BLOCKING
  WARNING_ONLY
}

model JourneyBlueprint {
  id                String   @id @default(uuid())
  parentBlueprintId String?
  policyId          String
  policyTitle       String
  version           Int      @default(1)
  name              String
  description       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parentBlueprint   JourneyBlueprint?        @relation("BlueprintHierarchy", fields: [parentBlueprintId], references: [id])
  childBlueprints    JourneyBlueprint[]       @relation("BlueprintHierarchy")
  versions          JourneyBlueprintVersion[]
  journeys          ApplicationJourney[]

  @@index([policyId])
  @@map("journey_blueprints")
}

model JourneyBlueprintVersion {
  id                   String   @id @default(uuid())
  blueprintId          String
  version              Int
  steps                Json
  documentRequirements Json
  createdAt            DateTime @default(now())

  blueprint            JourneyBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId, version])
  @@map("journey_blueprint_versions")
}

model ApplicationJourney {
  id             String                   @id @default(uuid())
  userId         String
  policyId       String
  policyTitle    String
  blueprintId    String
  status         ApplicationJourneyStatus @default(CREATED)
  urgency        JourneyUrgency           @default(MEDIUM)
  readinessScore Float                    @default(0.0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blueprint      JourneyBlueprint         @relation(fields: [blueprintId], references: [id])
  steps          ApplicationJourneyStep[]
  checklist      ApplicationChecklist?
  actionPlan     ActionPlan?
  snapshots      JourneySnapshot[]
  histories      JourneyHistory[]
  timelines      JourneyTimeline[]
  progresses     JourneyProgress[]

  @@index([userId])
  @@index([status])
  @@map("application_journeys")
}

model ApplicationJourneyStep {
  id                   String               @id @default(uuid())
  journeyId            String
  stepCode             String
  title                String
  description          String
  status               JourneyStepStatus    @default(NOT_STARTED)
  order                Int                  @default(1)
  isOptional           Boolean              @default(false)
  executionMode        StepExecutionMode    @default(MANUAL)
  owner                StepOwner            @default(CITIZEN)
  retryLimit           Int                  @default(3)
  retryIntervalMs      Int                  @default(60000)
  blockingBehavior     StepBlockingBehavior @default(BLOCKING)
  timeoutMs            Int                  @default(86400000)
  requiresVerification Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  journey              ApplicationJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@map("application_journey_steps")
}

model ApplicationStepDependency {
  id             String                @id @default(uuid())
  sourceStepId   String
  targetStepId   String
  dependencyType JourneyDependencyType @default(REQUIRES)

  @@index([sourceStepId, targetStepId])
  @@map("application_step_dependencies")
}

model ApplicationChecklist {
  id        String                 @id @default(uuid())
  journeyId String                 @unique
  status    ChecklistStatus        @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  journey   ApplicationJourney     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]

  @@map("application_checklists")
}

model ChecklistItem {
  id          String               @id @default(uuid())
