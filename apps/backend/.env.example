# Application Environment Configuration
PORT=3000
NODE_ENV=development
APP_NAME=GPIOS-Backend
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql://gpios_user:gpios_password@localhost:5432/gpios_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Configuration
JWT_SECRET=super-secret-gpios-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Knowledge Ingestion & Policy Intelligence Placeholders
KNOWLEDGE_STORAGE_PATH=./data/knowledge
KNOWLEDGE_MAX_DOCUMENT_SIZE=52428800
DEFAULT_REFRESH_INTERVAL=0 0 * * *
PDF_PARSER_TIMEOUT=30000
HTML_PARSER_TIMEOUT=15000
MAX_CHUNK_SIZE=1000
MAX_CHUNK_OVERLAP=200
