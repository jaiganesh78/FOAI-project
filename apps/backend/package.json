{
  "name": "@gpios/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx -p @nestjs/cli nest start --watch",
    "build": "npx -p @nestjs/cli nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "npx eslint \"src/**/*.ts\"",
    "lint:fix": "npx eslint \"src/**/*.ts\" --fix",
    "typecheck": "npx -p typescript@5.7.3 tsc --noEmit",
    "test": "npx vitest run src",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage",
    "test:e2e": "npx vitest run test/health.e2e-spec.ts",
    "prisma:generate": "npx prisma@6.3.0 generate",
    "prisma:migrate": "npx prisma@6.3.0 migrate dev",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "clean": "npx rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.738.0",
    "@gpios/shared": "workspace:*",
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.6",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.3.0",
    "@sentry/node": "^9.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.38.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "langfuse": "^3.35.0",
    "nestjs-pino": "^4.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.0.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.3.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
